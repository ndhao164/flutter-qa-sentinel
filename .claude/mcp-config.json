{
  "mcpServers": {
    "flutter-qa": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/flutter-mcp-server/dist/index.js"
      ],
      "env": {
        "FLUTTER_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR:-.}",
        "FLUTTER_MCP_TIMEOUT_MS": "120000",
        "FLUTTER_MCP_ALLOW_ADB_MUTATIONS": "0",
        "FLUTTER_MCP_ALLOW_IOS_MUTATIONS": "0",
        "FLUTTER_MCP_ALLOW_REMOTE_VM_SERVICE": "0"
      }
    }
  }
}
